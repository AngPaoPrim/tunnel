# Copy this file to .env and fill in values for local runs.
# Render does not deploy the gitignored .env file. Add it once as a Render
# Secret File named .env; the app reads it from /etc/secrets/.env.
TUNNEL_AGENT_TOKEN=
OAUTH_USERNAME=
OAUTH_PASSWORD=
OAUTH_CLIENT_ID=
OAUTH_REDIRECT_URIS=
OAUTH_CLIENT_SECRET=
OAUTH_DB_PATH=oauth.sqlite3
PUBLIC_BASE_URL=https://tunnel-8fvo.onrender.com
DEFAULT_LOCAL_TARGET=default
OAUTH_ALLOWED_TARGETS=default
