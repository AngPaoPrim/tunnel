# Copy this file to .env and fill in values for local runs.
# Deplexo does not load .env files from deplexo.yaml; configure deployed
# secrets in the Deplexo app's environment settings.
TUNNEL_AGENT_TOKEN=
TUNNEL_ACCESS_TOKEN=
OAUTH_USERNAME=
OAUTH_PASSWORD=
OAUTH_CLIENT_ID=
OAUTH_REDIRECT_URIS=
OAUTH_CLIENT_SECRET=
OAUTH_DB_PATH=oauth.sqlite3
PUBLIC_BASE_URL=https://tunnell.de.deplexo.com
TUNNEL_URL=https://tunnell.de.deplexo.com
DEFAULT_LOCAL_TARGET=default
OAUTH_ALLOWED_TARGETS=default
